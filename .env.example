# Postgres connection string used by @vercel/postgres (lib/db.ts).
#
# Local dev: copy this file to .env.local and point it at a Postgres
# database (e.g. a free Neon/Supabase instance, or `vercel env pull .env.local`
# after linking this project to a Vercel Postgres/Neon store).
#
# Production: once the project is linked to a Postgres store on Vercel, this
# is injected automatically — nothing to set manually.
POSTGRES_URL="postgres://user:password@host:5432/dbname"
