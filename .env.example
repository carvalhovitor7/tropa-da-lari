# Postgres connection string used by @vercel/postgres (lib/db.ts).
#
# Local dev: copy this file to .env.local and point it at a Postgres
# database (e.g. a free Neon/Supabase instance, or `vercel env pull .env.local`
# after linking this project to a Vercel Postgres/Neon store).
#
# Production: once the project is linked to a Postgres store on Vercel, this
# is injected automatically — nothing to set manually.
POSTGRES_URL="postgres://user:password@host:5432/dbname"

# 4-digit PIN that gates the whole Larissa-facing app (see proxy.ts / item 1
# "PIN gate"). Read server-side only, never sent to the client.
#
# Local dev: if this is unset, the app falls back to "1234" automatically
# (only when NODE_ENV !== "production"), so `npm run dev` works without a
# .env.local.
#
# Production: MUST be set on Vercel (Project Settings -> Environment
# Variables). If it's unset in production, the app fails closed — nobody can
# log in — rather than falling back to a guessable default.
APP_PIN=changeme
